{
  "manifest_version": 3,
  "name": "YouTube Music Player bridge (Omarchy)",
  "version": "1.0.0",
  "description": "Connects the Omarchy bar's YouTube Music player to music.youtube.com: queue, likes, search, library, lyrics and playback controls.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "other.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ]
}